# Copy this file to .env.local and fill in your keys. Never commit the real keys.
# Keys are only read by the server (Vite dev server or `npm start`); they are never sent to the browser.

# --- Free AI (no card needed) ---------------------------------------------
# Set both: if one is down, slow or over its free limit, the other answers automatically.

# 1. Groq, main provider: https://console.groq.com/keys
GROQ_API_KEY=

# 2. OpenRouter, backup provider: https://openrouter.ai/settings/keys
#    Free models allow about 20 requests a minute and 50 a day.
OPENROUTER_API_KEY=

# Optional models (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b        # for screenshots
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free   # then Gemma 4 31B / 26B if busy
# OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free         # for screenshots

# Your site address, sent to OpenRouter to identify the app
# LOVEMATE_PUBLIC_URL=https://your-app.onrender.com

# --- Paid, best quality (optional) ----------------------------------------
# Claude key from https://console.anthropic.com/ (tried first when set)
# ANTHROPIC_API_KEY=
# LOVEMATE_MODEL=claude-haiku-5-5      # cheapest; default is claude-opus-5-5

# --- Failover ---------------------------------------------------------------
# Order to try providers in (default: anthropic,groq,openrouter; only providers with a key are used)
# LOVEMATE_AI_PROVIDERS=groq,openrouter
# Milliseconds to wait for a provider before switching to the next one (default 45000)
# LOVEMATE_AI_TIMEOUT_MS=45000

# Optional: max AI requests per IP per minute (default 30)
# LOVEMATE_RATE_LIMIT=30

# --- Accounts and database (optional) ---------------------------------------
# Free Supabase project: https://supabase.com/dashboard. Run supabase/schema.sql once in its SQL Editor.
# Both values are public (they ship to the browser); Row Level Security protects the data.
# Without them, accounts and data stay in the browser only.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Payments (Razorpay, optional) ------------------------------------------
# https://dashboard.razorpay.com -> Account & Settings -> API Keys (use Test Mode keys first).
# The plans (Plus/Couple, monthly/yearly) are created in Razorpay automatically on the first checkout.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# Webhooks -> add https://YOUR-SITE/api/pay/webhook with subscription events, then paste its secret:
# RAZORPAY_WEBHOOK_SECRET=
# Supabase secret key (Project Settings -> API Keys -> Secret). Server only, never in the browser.
# Lets the server save verified paid plans; users can only read their own.
# SUPABASE_SECRET_KEY=sb_secret_...

# --- Email notifications (Nodemailer, optional) -------------------------------
# Gmail: use a separate account, turn on 2-Step Verification, then Google Account -> Security -> App passwords.
# Render's free plan blocks SMTP; a VPS (or paid instance) is needed to send.
# SMTP_USER=lovemate.app@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_HOST=smtp.gmail.com            # default
# SMTP_PORT=465                       # default (465 = SSL, 587 = STARTTLS)
# MAIL_FROM=LoveMate <lovemate.app@gmail.com>
# MAIL_FOOTER_ADDRESS=LoveMate, City, State, India
# Signs unsubscribe links (defaults to SUPABASE_SECRET_KEY):
# NOTIFY_SECRET=any-long-random-text
# Optional: let an outside cron call POST /api/notify/run with header x-cron-secret (the server also runs it hourly):
# NOTIFY_CRON_SECRET=another-long-random-text

# Secret address for the admin dashboard, e.g. ops-7f3k9q -> opens at #/ops-7f3k9q (nothing links to it).
# Hides the page only; data still needs a signed-in account listed in ADMIN_EMAILS.
# VITE_ADMIN_PATH=
# Comma-separated emails allowed to open the admin dashboard (server side):
# ADMIN_EMAILS=you@example.com
